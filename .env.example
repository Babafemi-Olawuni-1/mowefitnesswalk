# =====================================================================
# Mowe-Ibafo X Community Fitness Walk 2026 — Frontend environment
#
# Copy to `.env` (or `.env.local`) for local development.
#
# ⚠️  ONLY PUBLIC values may ever carry the VITE_ prefix.
# ⚠️  NEVER create a VITE_SUPABASE_SERVICE_ROLE_KEY. The React app talks
#     to the Node API, never to Supabase or PostgreSQL directly.
# =====================================================================

# Base URL of the Node/Express API, including the /api prefix, no trailing slash.
# Local:  http://localhost:3000/api
# Prod:   https://<your-render-service>.onrender.com/api
VITE_API_URL=http://localhost:3000/api
