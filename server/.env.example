# =====================================================================
# Mowe-Ibafo X Community Fitness Walk 2026 — Backend environment
#
# Copy to `.env` and fill in real values.
# NEVER commit a filled-in `.env`.
# NEVER put a VITE_ prefix on anything in this file.
# =====================================================================

NODE_ENV=development

# Render injects PORT automatically. The local default is 3000.
PORT=3000

# Supabase -> Project Settings -> Database -> Connection string
# Use the "URI" format, and add ?sslmode=require
DATABASE_URL=

# Supabase -> Project Settings -> API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Public URL of this API once deployed on Render (no trailing slash)
APP_URL=http://localhost:3000

# Public URL of the React app (no trailing slash)
FRONTEND_URL=http://localhost:5173

# Base URL encoded into the QR code. Point this at the React /verify page.
# Must contain the literal token {id}, e.g.
#   https://mowefitnesswalk.netlify.app/verify?id={id}
QR_BASE_URL=http://localhost:5173/verify?id={id}

# Participant id prefix, e.g. MIWC2026 -> MIWC2026-000001
PARTICIPANT_PREFIX=MIWC2026

# Upload limits
MAX_UPLOAD_SIZE=5242880
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

APP_TIMEZONE=Africa/Lagos

# Optional comma-separated allowlist. When empty, any account that exists
# in public.admins can sign in. When set, only these emails are allowed.
ADMIN_EMAILS=

# --- Transactional email ---------------------------------------------
# MAIL_PROVIDER: smtp | resend | log
MAIL_PROVIDER=log

# Resend (used when MAIL_PROVIDER=resend)
RESEND_API_KEY=

# Nodemailer / SMTP (used when MAIL_PROVIDER=smtp)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_FROM_NAME=Mowe-Ibafo X Community

# --- Logging ----------------------------------------------------------
LOG_LEVEL=info

# --- Rate limiting ----------------------------------------------------
# Window is always 15 minutes. Counts are per IP.
RATE_LIMIT_REGISTER_MAX=10
RATE_LIMIT_LOGIN_MAX=8
RATE_LIMIT_GENERAL_MAX=300

# --- Signed URL lifetime for the private participant-photos bucket ----
SIGNED_URL_TTL_SECONDS=3600

# --- Test / local overrides ------------------------------------------
# Set to true to boot without Supabase Auth validating live tokens.
# Only ever true in local tests.
AUTH_STRICT=true
